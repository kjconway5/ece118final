
digraph fsm {

    // header
    // rankdir=LR;
InitPSubState[shape = "point", color = "black",style="filled",width=.1,forcelabels=false];

    // states
    node [shape=plaintext]

    Spinning [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" style="rounded">
        <TR>
            <TD BORDER="1" SIDES="B">Spinning</TD>
        </TR>
        <TR>
            <TD ALIGN="LEFT"><B>/Entry: </B></TD>
        </TR>
        <TR>
            <TD ALIGN="LEFT"><B>/Exit: </B></TD>
        </TR>
</TABLE>>];


    MoveBackward [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" style="rounded">
        <TR>
            <TD BORDER="1" SIDES="B">MoveBackward</TD>
        </TR>
        <TR>
            <TD ALIGN="LEFT"><B>/Entry: </B></TD>
        </TR>
        <TR><TD ALIGN="LEFT">                ES_Timer_InitTimer(12, 1000);</TD></TR>
        <TR>
            <TD ALIGN="LEFT"><B>/Exit: </B></TD>
        </TR>
</TABLE>>];


    MoveForward [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" style="rounded">
        <TR>
            <TD BORDER="1" SIDES="B">MoveForward</TD>
        </TR>
        <TR>
            <TD ALIGN="LEFT"><B>/Entry: </B></TD>
        </TR>
        <TR>
            <TD ALIGN="LEFT"><B>/Exit: </B></TD>
        </TR>
</TABLE>>];


    Aligned [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" style="rounded">
        <TR>
            <TD BORDER="1" SIDES="B">Aligned</TD>
        </TR>
        <TR>
            <TD ALIGN="LEFT"><B>/Entry: </B></TD>
        </TR>
        <TR>
            <TD ALIGN="LEFT"><B>/Exit: </B></TD>
        </TR>
</TABLE>>];


    // guards

    244 [shape=point, xlabel="            if (ThisEvent.EventType == ES_TIMEOUT && ThisEvent.EventParam == 12) {
"];

    // transitions
InitPSubState -> Spinning[label=<<TABLE BORDER="0" CELLBORDER="0">
        <TR><TD BORDER="1" SIDES="B">(ES_TIMEOUT)(6)</TD></TR>
        </TABLE>>];

Spinning -> MoveBackward[label=<<TABLE BORDER="0" CELLBORDER="0">
        <TR><TD BORDER="1" SIDES="B">BEACON_DETECTED</TD></TR>
        </TABLE>>];

MoveBackward -> 244[label=<<TABLE BORDER="0" CELLBORDER="0">
        <TR><TD BORDER="1" SIDES="B">(ES_TIMEOUT)(12)</TD></TR>
            <TR><TD ALIGN="LEFT">                DriveBackward(500);</TD></TR>
            <TR><TD ALIGN="LEFT">            }</TD></TR>
            <TR><TD ALIGN="LEFT">                StopDriving();</TD></TR>
            <TR><TD ALIGN="LEFT">            }</TD></TR>
        </TABLE>>];

244 -> MoveForward[label=<<TABLE BORDER="0" CELLBORDER="0">
        <TR><TD BORDER="1" SIDES="B">TRUE</TD></TR>
        </TABLE>>];

MoveForward -> Aligned[label=<<TABLE BORDER="0" CELLBORDER="0">
        <TR><TD BORDER="1" SIDES="B">LEFT_TAPE_ON</TD></TR>
        </TABLE>>];


}
